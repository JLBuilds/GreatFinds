# Supabase — from your project's Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Maps Platform — one key with "Maps JavaScript API" and
# "Places API (New)" enabled. Restrict it to your domains.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# The app's public URL (used in invite emails / signup links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Comma-separated admin emails — gates the invites/admin screens
ADMIN_EMAILS=jolehndorf@gmail.com
# Optional separate recipient list for access-request notifications
ADMIN_NOTIFICATION_TO=

# Resend (optional — invite links can be copied from the UI instead)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
